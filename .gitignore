/ca_leginfo_cache
/ca_billtext_cache
cel_cache/
*.zip

# --- Truly raw/intermediate data: never committed ---
data/raw/

# --- Pipeline working files that live at the project root because the
# scripts write them there directly (CSVs, JSON, zips). The leading slash
# anchors these to the repo root ONLY, so it does NOT affect the curated
# copies you deliberately place in replication/data/ for publishing -- those
# stay tracked. Anything landing loose at root is raw/regenerable, not a
# deliberate publish decision, so it's ignored by default. ---
/*.csv
/*.csv.gz
/*.json

# --- Probe/scratch outputs from API exploration ---
legiscan_probe*_dataset.zip
legiscan_probe*_sample_bill.json
legiscan_schema_probe.json

# --- Local-only Claude Code project notes ---
CLAUDE.md

# --- Never commit credentials ---
*api_key*
.env

# --- OS / editor cruft ---
.DS_Store
__pycache__/
*.pyc
.vscode/
.idea/

# --- Python environments, if you ever set one up here ---
venv/
.venv/

# --- Final tables: the two full-text tables are too large for GitHub and are
# published on Harvard Dataverse instead (see README). The other five are tracked. ---
datasets/*/table4_state_bill_text.*
datasets/*/table5_federal_bill_text.*

# --- Regenerated by classify_status.py ---
/status_classification_report.txt

# --- Logs from long-running fetches ---
/*.log

# --- Files prepared for the Harvard Dataverse deposit (too large for GitHub) ---
/dataverse_upload

# --- Written by replication/validate_tables.py ---
/validation_sample.tsv

# --- Local guide to this laptop's file layout (mentions the external drive) ---
/WHERE_THINGS_ARE.md
