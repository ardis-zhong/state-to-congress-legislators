# --- Raw API caches: large, regenerate locally with your own API key ---
# (not the same as the *processed* summary tables below, which ARE published --
# see data/processed/ and the README's "Data sources and licensing" section)
legiscan_session_cache/
legiscan_dataset_cache/
legiscan_billtext_cache/
federal_billtext_cache/
*.zip

# --- Truly raw/intermediate data: never committed ---
data/raw/

# --- Pipeline working files that live at the project root because the
# scripts write them there directly (CSVs, JSON, zips). The leading slash
# anchors these to the repo root ONLY, so it does NOT affect the curated
# copies you deliberately place in data/processed/ for publishing -- those
# stay tracked. Anything landing loose at root is raw/regenerable, not a
# deliberate publish decision, so it's ignored by default. ---
/*.csv
/*.csv.gz
/*.json
# ...except these root-level pipeline files, which are small, hand-curated
# or not cheaply regenerable, and are needed to rerun the build:
!/billcount_FINAL.csv
!/extraction_queue.csv
!/extraction_queue_new109.csv
!/state_bill_targets_full.csv

# --- Probe/scratch outputs from API exploration ---
legiscan_probe*_dataset.zip
legiscan_probe*_sample_bill.json
legiscan_schema_probe.json

# --- Never commit credentials ---
*api_key*
.env

# --- OS / editor cruft ---
.DS_Store
__pycache__/
*.pyc
.vscode/
.idea/

# --- Python environments, if you ever set one up here ---
venv/
.venv/
